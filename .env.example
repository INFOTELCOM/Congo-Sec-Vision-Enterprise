# Laboratoire local uniquement. Remplacer ces valeurs avant le démarrage.
AGENT_ENROLLMENT_TOKEN=CHANGE_ME_WITH_ANOTHER_LONG_RANDOM_SECRET
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
DATABASE_PATH=/data/congo_sec_vision.db
SOC_BIND_IP=127.0.0.1

# Options facultatives
ALLOWED_ORIGINS=https://infotelcom.github.io
NVD_API_KEY=
# OpenCVE API v2 (jeton d'organisation en lecture seule ; jamais dans le navigateur)
OPENCVE_API_TOKEN=
OPENCVE_API_BASE_URL=https://app.opencve.io/api/v2
# Intervalle entre pages NVD (6.1s sans clé, 0.7s avec clé par défaut)
NVD_REQUEST_INTERVAL_SECONDS=
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# Synchronisation CVE automatique (cycle de balayage complet par lots)
CVE_SYNC_INTERVAL_MINUTES=15
CVE_SYNC_PRODUCT_INTERVAL_SECONDS=
CVE_SYNC_BATCH_SIZE=25

# Analyse LLM OpenAI-compatible (laisser vide pour conserver le moteur local)
# Exemple OpenAI : https://api.openai.com/v1
# Exemple Ollama local : http://host.docker.internal:11434/v1
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# Hypervisor inventory connectors (server-side only; leave blank when unused)
# Synthetic test inventory only; false by default and never synchronized to Supabase.
CSV_HYPERVISOR_LAB_MODE=false
CSV_VMWARE_URL=
CSV_VMWARE_USERNAME=
CSV_VMWARE_PASSWORD=
CSV_VMWARE_VERIFY_TLS=true
CSV_PROXMOX_URL=
CSV_PROXMOX_TOKEN_ID=
CSV_PROXMOX_TOKEN_SECRET=
CSV_PROXMOX_VERIFY_TLS=true
CSV_VBOXMANAGE_PATH=VBoxManage
# Jeton dédié au collecteur VirtualBox Windows (généré localement, jamais dans Git)
CSV_VBOX_COLLECTOR_TOKEN=
CSV_HYPERV_HOST=
CSV_HYPERV_USERNAME=
CSV_HYPERV_PASSWORD=
CSV_HYPERV_TRANSPORT=ntlm
