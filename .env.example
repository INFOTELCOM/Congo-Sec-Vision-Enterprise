# Laboratoire local uniquement. Remplacer ces valeurs avant le démarrage.
AGENT_ENROLLMENT_TOKEN=CHANGE_ME_WITH_ANOTHER_LONG_RANDOM_SECRET
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
DATABASE_PATH=/data/congo_sec_vision.db
SOC_BIND_IP=127.0.0.1

# Options facultatives
ALLOWED_ORIGINS=https://infotelcom.github.io
NVD_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# Synchronisation CVE automatique (cycle de balayage complet par lots)
CVE_SYNC_INTERVAL_HOURS=24
CVE_SYNC_BATCH_SIZE=25

# Analyse LLM OpenAI-compatible (laisser vide pour conserver le moteur local)
# Exemple OpenAI : https://api.openai.com/v1
# Exemple Ollama local : http://host.docker.internal:11434/v1
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
